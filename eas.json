{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_CTX_CLIENT_ID": "loopapp"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_CTX_API_URL": "https://staging.spend.ctx.com",
        "EXPO_PUBLIC_STELLAR_NETWORK": "testnet"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CTX_API_URL": "https://staging.spend.ctx.com",
        "EXPO_PUBLIC_STELLAR_NETWORK": "testnet"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_CTX_API_URL": "https://spend.ctx.com",
        "EXPO_PUBLIC_STELLAR_NETWORK": "mainnet"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
